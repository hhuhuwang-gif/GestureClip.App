<Window x:Class="GestureClip.App.PinImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="贴图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        MouseWheel="Window_MouseWheel"
        KeyDown="Window_KeyDown">
    <Border CornerRadius="8"
            ClipToBounds="True"
            BorderBrush="#883B82F6"
            BorderThickness="1.5"
            Background="#FFFFFFFF"
            ToolTip="拖动移动 · 滚轮缩放 · 双击或 Esc 关闭">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.30" Direction="270" />
        </Border.Effect>
        <Image x:Name="PinnedImage"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </Border>
</Window>
