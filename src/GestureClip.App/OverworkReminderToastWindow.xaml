<Window x:Class="GestureClip.App.OverworkReminderToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="194"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        AutomationProperties.Name="工位小熊休息提醒">
    <Window.Resources>
        <RadialGradientBrush x:Key="ReminderAmbient" Center="0.08,0.04" GradientOrigin="0.08,0.04"
                             RadiusX="0.72" RadiusY="1.2">
            <GradientStop Color="#243B82F6" Offset="0" />
            <GradientStop Color="#102DD4BF" Offset="0.52" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </RadialGradientBrush>
        <Style x:Key="ReminderTagStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySoft}" />
            <Setter Property="BorderBrush" Value="#303B82F6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="20" ClipToBounds="True"
            Background="{DynamicResource BrushOverlayPanel}"
            BorderBrush="{DynamicResource BrushGlassRim}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#17344F" BlurRadius="28" ShadowDepth="8" Opacity="0.24" Direction="270" />
        </Border.Effect>
        <Grid>
            <Border Background="{StaticResource ReminderAmbient}" IsHitTestVisible="False" />
            <Grid Margin="18,16,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="11"
                            Background="{DynamicResource BrushPrimarySoft}"
                            BorderBrush="{DynamicResource BrushGlassRim}" BorderThickness="1">
                        <TextBlock Text="熊" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushPrimaryBright}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,12,0">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="工位小熊 / 健康提醒" Margin="0,3,0,0" FontSize="10"
                                   Foreground="{DynamicResource BrushTextMuted}" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource ReminderTagStyle}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StageText}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushPrimaryBright}" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" Margin="44,11,4,0">
                    <TextBlock Text="{Binding Message}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Margin="0,5,0,0" FontSize="11.5"
                               Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="44,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="8 秒后自动关闭" VerticalAlignment="Center" FontSize="10"
                               Foreground="{DynamicResource BrushTextMuted}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="知道了" MinWidth="78" Height="32"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="关闭休息提醒"
                                Click="DismissButton_Click" />
                        <Button Content="稍后提醒" MinWidth="88" Height="32" Margin="7,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding SnoozeButtonVisibility}"
                                AutomationProperties.Name="稍后再提醒"
                                Click="SnoozeButton_Click" />
                        <Button Content="今天不再提醒" MinWidth="108" Height="32" Margin="7,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="今天不再提醒"
                                Click="MuteTodayButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
