<Window x:Class="GestureClip.App.GestureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="800"
        Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, Segoe UI Emoji, Segoe UI Symbol"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <!-- Transparent overlays: Grayscale beats ClearType (less purple/blur on Chinese). -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Segoe UI Emoji, Segoe UI Symbol" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="HudMonoText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <!-- Mono only for pure codes/numbers; still fall back to YaHei for CJK. -->
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI, Segoe UI" />
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" IsHitTestVisible="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Canvas IsHitTestVisible="False">
            <!-- Soft neon under-glow tinted by the user's stroke color -->
            <Polyline x:Name="TrailGlowLine"
                      Points="{Binding Points}"
                      Stroke="{Binding StrokeBrush}"
                      StrokeThickness="9"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Opacity="0.22">
                <Polyline.Effect>
                    <DropShadowEffect Color="{Binding StrokeGlowColor}"
                                      BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.55" />
                </Polyline.Effect>
            </Polyline>
            <Polyline x:Name="TrailLine"
                      Points="{Binding Points}"
                      Stroke="{Binding StrokeBrush}"
                      StrokeThickness="2.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Opacity="0.97" />
            <!-- Success/fail pulse painted over the trail on completion -->
            <Polyline x:Name="TrailFeedbackLine"
                      Points="{Binding Points}"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Opacity="0" />
        </Canvas>
        <Border x:Name="CompactGameHud"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,64"
                MinWidth="380"
                MaxWidth="520"
                MinHeight="104"
                CornerRadius="18"
                Padding="14,12"
                Background="{DynamicResource HudCardBrush}"
                BorderBrush="{DynamicResource WindowEdgeBrush}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                IsHitTestVisible="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="56"
                        Height="56"
                        CornerRadius="16"
                        Background="{DynamicResource FillBrush}"
                        BorderBrush="{DynamicResource WindowEdgeBrush}"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding DirectionText}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActionName}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,4"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding ShortcutText}"
                                   Style="{StaticResource HudMonoText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding WorkStatusText}"
                               Foreground="{Binding HudAccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>