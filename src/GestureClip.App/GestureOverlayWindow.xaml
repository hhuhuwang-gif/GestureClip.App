<Window x:Class="GestureClip.App.GestureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="800"
        Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, Segoe UI Emoji, Segoe UI Symbol"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <!-- Transparent overlays: Grayscale beats ClearType (less purple/blur on Chinese). -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Segoe UI Emoji, Segoe UI Symbol" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="HudMonoText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <!-- Mono only for pure codes/numbers; still fall back to YaHei for CJK. -->
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI, Segoe UI" />
        </Style>
        <Style x:Key="HudStatChip" TargetType="Border">
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="HudStatLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#FF94A3B8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HudStatValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" IsHitTestVisible="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Canvas IsHitTestVisible="False">
            <!-- Soft neon under-glow tinted by the user's stroke color -->
            <Polyline x:Name="TrailGlowLine"
                      Points="{Binding Points}"
                      Stroke="{Binding StrokeBrush}"
                      StrokeThickness="9"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Opacity="0.22">
                <Polyline.Effect>
                    <DropShadowEffect Color="{Binding StrokeGlowColor}"
                                      BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.55" />
                </Polyline.Effect>
            </Polyline>
            <Polyline x:Name="TrailLine"
                      Points="{Binding Points}"
                      Stroke="{Binding StrokeBrush}"
                      StrokeThickness="2.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Opacity="0.97" />
            <!-- Success/fail pulse painted over the trail on completion -->
            <Polyline x:Name="TrailFeedbackLine"
                      Points="{Binding Points}"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Opacity="0" />
        </Canvas>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,70"
                MinWidth="720"
                MaxWidth="920"
                MinHeight="200"
                CornerRadius="18"
                Padding="16,14"
                Background="{Binding HudBackgroundBrush}"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                x:Name="CompactGameHud"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                IsHitTestVisible="True">
            <Border.Effect>
                <DropShadowEffect Color="#101827" BlurRadius="22" ShadowDepth="5" Opacity="0.22" />
            </Border.Effect>
            <Grid x:Name="GestureActionStrip" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="188" />
                </Grid.ColumnDefinitions>

                <Border Width="72"
                        Height="72"
                        CornerRadius="20"
                        Background="#F0111724"
                        BorderBrush="#8893C5FD"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding DirectionText}"
                               Foreground="#FFFFFFFF"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="4,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="工位小熊"
                                   Foreground="{Binding HudAccentBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="  ·  "
                                   Foreground="#FF94A3B8"
                                   FontSize="13" />
                        <TextBlock Text="{Binding PresetName}"
                                   Foreground="#FFE2E8F0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Text="{Binding ActionName}"
                               Foreground="#FFFFFFFF"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ShortcutText}"
                                   Foreground="#FFE2E8F0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="   手势码 "
                                   Foreground="#FF94A3B8"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Pattern}"
                                   Style="{StaticResource HudMonoText}"
                                   Foreground="{Binding HudAccentBrush}"
                                   FontSize="13"
                                   FontWeight="Bold" />
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FunText}"
                                   Foreground="{Binding HudAccentBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding GainedXpText}"
                                   Foreground="#FF86EFAC"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding LevelText}"
                                   Foreground="#FFF1F5F9"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding XpText}"
                                   Style="{StaticResource HudMonoText}"
                                   Foreground="{Binding HudAccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ProgressBar Minimum="0"
                                 Maximum="1"
                                 Value="{Binding XpProgressPercent}"
                                 Height="5"
                                 Margin="0,7,0,0"
                                 Foreground="{Binding HudAccentBrush}"
                                 Background="#33FFFFFF"
                                 BorderThickness="0" />

                    <!-- Work summary + stats chips (high contrast, no mono CJK) -->
                    <StackPanel x:Name="TodayStatsLine" Margin="0,10,0,0">
                        <TextBlock Text="{Binding WorkSummaryText}"
                                   Foreground="#FFF8FAFC"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Style="{StaticResource HudStatChip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="手势" Style="{StaticResource HudStatLabel}" />
                                    <TextBlock Text="{Binding GestureCountText}" Style="{StaticResource HudStatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HudStatChip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="复制" Style="{StaticResource HudStatLabel}" />
                                    <TextBlock Text="{Binding CopyCountText}" Style="{StaticResource HudStatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HudStatChip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="粘贴" Style="{StaticResource HudStatLabel}" />
                                    <TextBlock Text="{Binding PasteCountText}" Style="{StaticResource HudStatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HudStatChip}" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="少点" Style="{StaticResource HudStatLabel}" />
                                    <TextBlock Text="{Binding SavedClicksCountText}" Style="{StaticResource HudStatValue}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                                    <!-- Unbound: one-click open action binding -->
                                    <Border x:Name="BindActionBar"
                                            Margin="0,10,0,0"
                                            Padding="10,8"
                                            CornerRadius="10"
                                            Background="#CC1D4ED8"
                                            BorderBrush="#99BFDBFE"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            IsHitTestVisible="True"
                                            Visibility="{Binding ShowBindAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            MouseLeftButtonUp="BindActionBar_MouseLeftButtonUp">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Content="{Binding BindActionButtonText}"
                                                    Command="{Binding BindUnboundGestureCommand}"
                                                    Padding="12,4"
                                                    MinWidth="72"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"
                                                    IsHitTestVisible="True"
                                                    Background="#FFF8FAFC"
                                                    Foreground="#FF1E3A8A"
                                                    BorderThickness="0" />
                                            <TextBlock Text="{Binding BindActionHintText}"
                                                       Foreground="#FFF8FAFC"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,10,0" />
                                        </DockPanel>
                                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="松开右键执行"
                               Foreground="{Binding HudAccentBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding WorkStatusText}"
                               Foreground="#FFE2E8F0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="普通右键不显示"
                               Foreground="#FF94A3B8"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
