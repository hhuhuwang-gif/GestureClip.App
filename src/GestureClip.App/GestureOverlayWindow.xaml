<Window x:Class="GestureClip.App.GestureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="800" Height="450" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        IsHitTestVisible="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, Segoe UI Emoji, Segoe UI Symbol"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/GestureHudStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="RootGrid" IsHitTestVisible="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Canvas IsHitTestVisible="False">
            <Polyline x:Name="TrailGlowLine" Points="{Binding Points}" Stroke="{Binding StrokeBrush}"
                      StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Opacity="0.18" />
            <Polyline x:Name="TrailLine" Points="{Binding Points}" Stroke="{Binding StrokeBrush}"
                      StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Opacity="0.97" />
            <Polyline x:Name="TrailFeedbackLine" Points="{Binding Points}" StrokeThickness="4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" />
        </Canvas>

        <Border x:Name="CompactGameHud" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="24,0,24,70" MinWidth="720" MaxWidth="820" MinHeight="200"
                CornerRadius="20" Background="{StaticResource HudSurfaceGradient}"
                BorderBrush="{StaticResource HudSurfaceRim}" BorderThickness="1"
                SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="True">
            <Grid x:Name="GestureActionStrip">
                <!-- 1. 时间主题色 wash -->
                <Border x:Name="HudThemeWash" Background="{Binding HudBackgroundBrush}" Opacity="0.12"
                        CornerRadius="19" IsHitTestVisible="False" />
                <!-- 2. 右上角千秋青氛围光 -->
                <Border x:Name="HudAmbientGlow" Background="{StaticResource HudAmbientGradient}"
                        CornerRadius="19" IsHitTestVisible="False" />
                <!-- 3. 缓慢漂移的青色液体光 -->
                <Border x:Name="HudLiquidTeal" CornerRadius="19" IsHitTestVisible="False" Opacity="0.8">
                    <Border.Background>
                        <RadialGradientBrush Center="0.28,0.8" GradientOrigin="0.18,0.9" RadiusX="0.72" RadiusY="1.3">
                            <RadialGradientBrush.RelativeTransform><TranslateTransform /></RadialGradientBrush.RelativeTransform>
                            <GradientStop Color="#6E2CB8C6" Offset="0" />
                            <GradientStop Color="#24238F9C" Offset="0.48" />
                            <GradientStop Color="#00238F9C" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <!-- 4. 缓慢漂移的紫罗兰液体光 -->
                <Border x:Name="HudLiquidViolet" CornerRadius="19" IsHitTestVisible="False" Opacity="0.75">
                    <Border.Background>
                        <RadialGradientBrush Center="0.86,0.18" GradientOrigin="0.93,0.08" RadiusX="0.65" RadiusY="1.5">
                            <RadialGradientBrush.RelativeTransform><TranslateTransform /></RadialGradientBrush.RelativeTransform>
                            <GradientStop Color="#686C64C8" Offset="0" />
                            <GradientStop Color="#25495CA8" Offset="0.5" />
                            <GradientStop Color="#00495CA8" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <!-- 5. 数码点阵底纹 -->
                <Border x:Name="HudPixelGrid" Background="{StaticResource HudPixelGridBrush}"
                        CornerRadius="19" IsHitTestVisible="False" />
                <!-- 5b. 中心收束雾：压暗中央底纹，让正文更干净 -->
                <Border x:Name="HudCenterScrim" CornerRadius="19" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.98" RadiusY="1.32">
                            <GradientStop Color="#44050A14" Offset="0" />
                            <GradientStop Color="#22050A14" Offset="0.55" />
                            <GradientStop Color="#00050A14" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <!-- 6. 核心：方块流动渐变（青→靛→紫→品红，横向无限循环） -->
                <Border x:Name="HudPixelFlow" CornerRadius="19" IsHitTestVisible="False" Opacity="0.64"
                        OpacityMask="{StaticResource HudPixelMaskBrush}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                            <LinearGradientBrush.RelativeTransform><TranslateTransform /></LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#0012A0C8" Offset="0" />
                            <GradientStop Color="#5212A0C8" Offset="0.05" />
                            <GradientStop Color="#5A3F62D8" Offset="0.13" />
                            <GradientStop Color="#5A7350D8" Offset="0.2" />
                            <GradientStop Color="#52AE4480" Offset="0.27" />
                            <GradientStop Color="#0012A0C8" Offset="0.34" />
                            <GradientStop Color="#0012A0C8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- 6b. 斜向副数据流：与主色带交错，形成交汇的流动渐变 -->
                <Border x:Name="HudPixelFlowAlt" CornerRadius="19" IsHitTestVisible="False" Opacity="0.24"
                        OpacityMask="{StaticResource HudPixelMaskBrush}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.42,1" SpreadMethod="Repeat">
                            <LinearGradientBrush.RelativeTransform><TranslateTransform /></LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#0012A0C8" Offset="0" />
                            <GradientStop Color="#0012A0C8" Offset="0.5" />
                            <GradientStop Color="#5A22C9D6" Offset="0.63" />
                            <GradientStop Color="#5A6A5AE0" Offset="0.77" />
                            <GradientStop Color="#0012A0C8" Offset="0.93" />
                            <GradientStop Color="#0012A0C8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- 7. 垂直扫描光柱 -->
                <Border x:Name="HudScanBeam" CornerRadius="19" IsHitTestVisible="False" Opacity="0.55">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                            <LinearGradientBrush.RelativeTransform><TranslateTransform /></LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#00E8FBFF" Offset="0" />
                            <GradientStop Color="#00E8FBFF" Offset="0.4" />
                            <GradientStop Color="#1CE8FBFF" Offset="0.47" />
                            <GradientStop Color="#3AE8FBFF" Offset="0.5" />
                            <GradientStop Color="#1CE8FBFF" Offset="0.53" />
                            <GradientStop Color="#00E8FBFF" Offset="0.6" />
                            <GradientStop Color="#00E8FBFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- 8. 顶部 1px 镜面高光 + 底部收边 -->
                <Border VerticalAlignment="Top" Height="1" Margin="16,0,16,0"
                        Background="{StaticResource HudTopHighlightBrush}" IsHitTestVisible="False" />
                <Border VerticalAlignment="Bottom" Height="1" Margin="16,0,16,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00020A12" Offset="0" />
                            <GradientStop Color="#80020A12" Offset="0.5" />
                            <GradientStop Color="#00020A12" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Margin="22,15,22,15">
                    <!-- 标题行 -->
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource HudReleaseHint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid x:Name="HudMarkIcon" Width="13" Height="13" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Background="#3EE0D0" CornerRadius="1.2" Margin="0,0,1.5,1.5" />
                                <Border Grid.Row="0" Grid.Column="1" Background="#7C86F8" CornerRadius="1.2" Margin="1.5,0,0,1.5" />
                                <Border Grid.Row="1" Grid.Column="0" Background="#B06BF0" CornerRadius="1.2" Margin="0,1.5,1.5,0" />
                                <Border Grid.Row="1" Grid.Column="1" Background="#F472B6" CornerRadius="1.2" Margin="1.5,1.5,0,0" />
                            </Grid>
                            <TextBlock Text="GESTURECLIP" Style="{StaticResource HudLabel}" FontWeight="SemiBold" />
                            <TextBlock Text=" / 工位小熊" Style="{StaticResource HudLabel}" Margin="4,0,10,0" />
                            <TextBlock Text="{Binding PresetName}" Foreground="#FFCBD5E1" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource HudDividerBrush}" Margin="0,0,0,11" IsHitTestVisible="False" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <!-- 动作区聚焦柔光 -->
                        <Border Grid.ColumnSpan="3" IsHitTestVisible="False" Opacity="0.6">
                            <Border.Background>
                                <RadialGradientBrush Center="0.15,0.38" GradientOrigin="0.15,0.38" RadiusX="0.42" RadiusY="1.1">
                                    <GradientStop Color="#267FD8F0" Offset="0" />
                                    <GradientStop Color="#007FD8F0" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- 方向数码面板 -->
                        <Border Width="62" Height="58" HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="11" Background="#0CFFFFFF" BorderBrush="#2E8FE8F0" BorderThickness="1">
                            <Grid>
                                <Border Background="#08FFFFFF" CornerRadius="11" />
                                <Border Height="2" VerticalAlignment="Top" Margin="11,6,11,0" CornerRadius="1"
                                        Background="{Binding HudAccentBrush}" Opacity="0.7" />
                                <Border Height="2" VerticalAlignment="Bottom" Margin="11,0,11,6" CornerRadius="1"
                                        Background="#33FFFFFF" />
                                <TextBlock Text="{Binding DirectionText}" FontSize="22" FontWeight="SemiBold"
                                           MaxWidth="48" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="#12FFFFFF" BorderBrush="#26FFFFFF"
                                        BorderThickness="1" CornerRadius="6" Padding="7,3"
                                        VerticalAlignment="Center" MaxWidth="130" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ShortcutText}" Foreground="#FFCBD5E1" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <TextBlock Text="{Binding ActionName}" Foreground="#FFFFFFFF" FontSize="26" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="手势码 " Style="{StaticResource HudLabel}" />
                                <TextBlock Text="{Binding Pattern}" Style="{StaticResource HudMonoText}" Foreground="{Binding HudAccentBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WorkStatusText}" Style="{StaticResource HudLabel}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding GainedXpText}" Foreground="#FF86EFAC" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding FunText}" Foreground="#FFCBD5E1" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="78,9,0,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding LevelText}" Style="{StaticResource HudLabel}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding XpText}" Style="{StaticResource HudMonoText}" Foreground="#FF94A3B8" />
                    </Grid>
                    <ProgressBar Style="{StaticResource HudXpProgress}" Value="{Binding XpProgressPercent}"
                                 Foreground="{Binding HudAccentBrush}" Margin="0,6,0,0" />

                    <Grid x:Name="TodayStatsLine" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding WorkSummaryText}" Style="{StaticResource HudLabel}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{StaticResource HudStatChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Height="4" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,6,0"
                                            Background="{Binding HudAccentBrush}" Opacity="0.9" />
                                    <TextBlock Text="手势" Style="{StaticResource HudStatLabel}" />
                                    <TextBlock Text="{Binding GestureCountText}" Style="{StaticResource HudStatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HudStatChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Height="4" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,6,0"
                                            Background="{Binding HudAccentBrush}" Opacity="0.9" />
                                    <TextBlock Text="复制" Style="{StaticResource HudStatLabel}" />
                                    <TextBlock Text="{Binding CopyCountText}" Style="{StaticResource HudStatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HudStatChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Height="4" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,6,0"
                                            Background="{Binding HudAccentBrush}" Opacity="0.9" />
                                    <TextBlock Text="粘贴" Style="{StaticResource HudStatLabel}" />
                                    <TextBlock Text="{Binding PasteCountText}" Style="{StaticResource HudStatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HudStatChip}" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Height="4" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,6,0"
                                            Background="{Binding HudAccentBrush}" Opacity="0.9" />
                                    <TextBlock Text="少点" Style="{StaticResource HudStatLabel}" />
                                    <TextBlock Text="{Binding SavedClicksCountText}" Style="{StaticResource HudStatValue}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
