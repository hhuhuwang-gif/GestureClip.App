<Window x:Class="GestureClip.App.WorkstationDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GestureClip.App.Controls"
        Title="工位小熊 Hub" Icon="Assets/GestureClip.ico"
        Width="1080" Height="820" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource BrushTextPrimary}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/HubOverview.xaml" />
                <ResourceDictionary Source="Themes/HubDetails.Activity.xaml" />
                <ResourceDictionary Source="Themes/HubDetails.Wellbeing.xaml" />
                <ResourceDictionary Source="Themes/HubDetails.Rules.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="HubSectionCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="20,8,20,16" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextPrimary}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="RootBorder" Background="{DynamicResource BrushAppBackground}" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Margin="0,0,0,24" MouseLeftButtonDown="WindowBackground_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,20,0">
                        <Button Style="{StaticResource TrafficLightButtonStyle}" Background="{DynamicResource BrushTrafficClose}" ToolTip="关闭" Click="CloseButton_Click" />
                        <Button Style="{StaticResource TrafficLightButtonStyle}" Background="{DynamicResource BrushTrafficYellow}" ToolTip="最大化 / 还原" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource TrafficLightButtonStyle}" Background="{DynamicResource BrushTrafficGreen}" ToolTip="最小化" Click="MinimizeButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Text="工位小熊" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="本地统计 · Esc 关闭 · 不上传" Style="{StaticResource HubMetricLabelStyle}" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding GreetingText}" Style="{StaticResource HubBodyStyle}" HorizontalAlignment="Right" />
                        <TextBlock Text="v0.6.47 · 本地" Style="{StaticResource HubMetricLabelStyle}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <controls:SmoothScrollViewer Grid.Row="1" Style="{StaticResource GlassScrollViewerStyle}"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HubSetupBody}" HorizontalContentAlignment="Stretch" />
                    <Border Style="{StaticResource BoardCardStyle}" Margin="0,0,0,24"
                            Visibility="{Binding ShowEmptySalaryGuide, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding EmptySalaryGuideTitle}" Style="{StaticResource BoardHeadingStyle}" />
                            <TextBlock Text="{Binding EmptySalaryGuideText}" Style="{StaticResource BoardBodyStyle}" Margin="0,8,0,16" />
                            <Button Content="{Binding EmptySalaryGuideActionText}" Command="{Binding OpenWorkRulesCommand}"
                                    Style="{StaticResource BoardPrimaryActionStyle}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HubOverviewBody}" HorizontalContentAlignment="Stretch" />
                    <ItemsControl ItemsSource="{Binding HolidayCountdownTexts}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><Border Style="{StaticResource HubChipStyle}" Margin="0,0,8,8"><TextBlock Text="{Binding}" Style="{StaticResource HubMetricLabelStyle}" /></Border></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="工作面板" Style="{StaticResource BoardHeadingStyle}" />
                    <TextBlock Text="常用状态一眼可见，详细数据与设置按需展开。" Style="{StaticResource BoardBodyStyle}" Margin="0,8,0,20" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Expander Header="收益与效率" Style="{StaticResource BoardHubDetailStyle}" Content="{Binding}"
                                  IsExpanded="{Binding EarningsExpanded, Mode=TwoWay}" ContentTemplate="{StaticResource HubEarningsBody}" />
                        <Expander Grid.Column="2" Header="摸鱼模式" Style="{StaticResource BoardHubDetailStyle}" Content="{Binding}"
                                  IsExpanded="{Binding FishingExpanded, Mode=TwoWay}" ContentTemplate="{StaticResource HubFishingBody}" />
                        <Expander Grid.Row="1" Header="休息提醒" Style="{StaticResource BoardHubDetailStyle}" Content="{Binding}"
                                  IsExpanded="{Binding RestExpanded, Mode=TwoWay}" ContentTemplate="{StaticResource HubRestBody}" />
                        <Expander Grid.Row="1" Grid.Column="2" Header="下班冲刺" Style="{StaticResource BoardHubDetailStyle}" Content="{Binding}"
                                  IsExpanded="{Binding SprintExpanded, Mode=TwoWay}" ContentTemplate="{StaticResource HubSprintBody}" />
                        <Expander Grid.Row="2" Header="今日生存报告" Style="{StaticResource BoardHubDetailStyle}" Content="{Binding}"
                                  IsExpanded="{Binding ReportExpanded, Mode=TwoWay}" ContentTemplate="{StaticResource HubReportBody}" />
                        <Expander Grid.Row="2" Grid.Column="2" Header="周报 / 月报（本地）" Style="{StaticResource BoardHubDetailStyle}" Content="{Binding}"
                                  IsExpanded="{Binding PeriodExpanded, Mode=TwoWay}" ContentTemplate="{StaticResource HubPeriodBody}" />
                        <Expander Grid.Row="3" Grid.ColumnSpan="3" Header="工作规则设置" Style="{StaticResource BoardHubDetailStyle}" Content="{Binding}"
                                  IsExpanded="{Binding SettingsExpanded, Mode=TwoWay}" ContentTemplate="{StaticResource HubRulesBody}" />
                    </Grid>
                </StackPanel>
            </controls:SmoothScrollViewer>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding LastMessage}" Style="{StaticResource HubBodyStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,8" />
                        <Button Content="打开设置" Click="OpenSettingsButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,8" />
                        <Button Content="迷你挂件" Click="ToggleWidgetButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,8" ToolTip="开关桌面小挂件，右键可更换桌宠图" />
                        <Button Content="重置今日" Command="{Binding ResetTodayCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,8" ToolTip="清空今日本地统计，需确认" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
