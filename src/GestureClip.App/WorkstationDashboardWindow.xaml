<Window x:Class="GestureClip.App.WorkstationDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hub="clr-namespace:GestureClip.App.Controls.Hub"
        Title="工位小熊 Hub" Icon="Assets/GestureClip.ico"
        Width="1120" Height="800" MinWidth="900" MinHeight="640"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI, Segoe UI Emoji"
        Foreground="{DynamicResource BrushTextPrimary}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True" Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/HubInteractionStyles.xaml" />
                <ResourceDictionary Source="Themes/HubDashboardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="RootBorder" Background="{DynamicResource BrushAppBackgroundSolid}" Padding="28,18,28,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
                <DockPanel MouseLeftButtonDown="WindowBackground_MouseLeftButtonDown" Margin="0,0,0,20">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource HubWindowButtonStyle}"
                                ToolTip="最小化" AutomationProperties.Name="最小化 Hub" Click="MinimizeButton_Click">
                            <Path Data="M 0,5 L 10,5" Width="10" Height="10" StrokeThickness="1.2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource HubWindowButtonStyle}"
                                ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原 Hub" Click="MaximizeButton_Click">
                            <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Width="10" Height="10" StrokeThickness="1.2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource HubWindowButtonStyle}"
                                ToolTip="关闭 · Esc" AutomationProperties.Name="关闭 Hub" Click="CloseButton_Click">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" StrokeThickness="1.2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/GestureClipIcon.png" Width="34" Height="34" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="GestureClip" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GESTURECLIP / WORKSPACE" Style="{StaticResource HubEyebrowStyle}" />
                            <TextBlock Text="v0.6.41 · 本地" Style="{StaticResource HubMetricLabelStyle}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,0,0">
                        <Button Content="总览" Tag="Overview" Style="{StaticResource HubNavigationButtonStyle}" Click="NavigateSection_Click" />
                        <Button Content="效率" Tag="Earnings" Style="{StaticResource HubNavigationButtonStyle}" Click="NavigateSection_Click" />
                        <Button Content="休息" Tag="Rest" Style="{StaticResource HubNavigationButtonStyle}" Click="NavigateSection_Click" />
                        <Button Content="报告" Tag="Report" Style="{StaticResource HubNavigationButtonStyle}" Click="NavigateSection_Click" />
                        <Button Content="工作规则" Tag="Rules" Style="{StaticResource HubNavigationButtonStyle}" Click="NavigateSection_Click" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="工位小熊" Style="{StaticResource HubRootTextStyle}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GreetingText}" Style="{StaticResource HubBodyStyle}" VerticalAlignment="Bottom" Margin="14,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource HubBodyStyle}" Margin="0,5,0,0" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="268" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="HubContentScroll" Style="{StaticResource GlassScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"
                              AutomationProperties.Name="Hub 工作台详情">
                    <StackPanel>
                        <hub:HubSetupSection />
                        <hub:HubOverviewCard x:Name="OverviewSection" />
                        <TextBlock Text="效率与记录" Style="{StaticResource HubEyebrowStyle}" Margin="4,8,0,12" />
                        <hub:HubEarningsSection x:Name="EarningsSection" />
                        <hub:HubFishingSection />
                        <TextBlock Text="工作节奏" Style="{StaticResource HubEyebrowStyle}" Margin="4,8,0,12" />
                        <hub:HubRestSection x:Name="RestSection" />
                        <hub:HubSprintSection />
                        <TextBlock Text="回顾与计划" Style="{StaticResource HubEyebrowStyle}" Margin="4,8,0,12" />
                        <hub:HubReportSection x:Name="ReportSection" />
                        <hub:HubPeriodSection />
                        <hub:HubRulesSection x:Name="RulesSection" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Column="2" Style="{StaticResource GlassScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"
                              AutomationProperties.Name="Hub 快捷操作">
                    <hub:HubQuickPanel />
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="0,1,0,0"
                    Padding="0,14,0,0" Margin="0,16,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource HubSecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="打开设置" Click="OpenSettingsButton_Click" Style="{StaticResource HubSecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="迷你挂件" Click="ToggleWidgetButton_Click" Style="{StaticResource HubSecondaryButtonStyle}" Margin="0,0,8,0"
                                ToolTip="开关桌面置顶小挂件，右键可更换桌宠图" />
                        <Button Content="重置今日" Command="{Binding ResetTodayCommand}" Style="{StaticResource HubDangerButtonStyle}"
                                ToolTip="清空今日本地统计，需确认且不可撤销" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastMessage}" Style="{StaticResource HubMetricLabelStyle}" />
                        <TextBlock Text="本地统计 · 不上传 · Esc 关闭" Style="{StaticResource HubMetricLabelStyle}" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
