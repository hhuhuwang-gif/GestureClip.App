<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GestureClip.App.Controls">
    <Style x:Key="SettingsToggleCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource GlassCheckBoxStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="controls:ToggleSwitchMotion.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="48" Height="36" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Track" Width="44" Height="26" CornerRadius="13"
                                Background="{DynamicResource BrushControlDisabled}"
                                BorderBrush="{DynamicResource BrushTextMuted}" BorderThickness="1" />
                        <Ellipse x:Name="Thumb" Width="20" Height="20" Margin="5,0,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="{DynamicResource BrushTextSecondary}">
                            <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrushPrimarySolid}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrushPrimarySolid}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrushPrimaryBright}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrushPrimaryBright}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
