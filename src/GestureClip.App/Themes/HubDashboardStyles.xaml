<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="HubSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushGlassStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="HubRootTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>
    <Style x:Key="HubBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource HubRootTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="HubMetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubBodyStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="HubMetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource HubRootTextStyle}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>
    <Style x:Key="HubDisplayValueStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMetricValueStyle}">
        <Setter Property="FontSize" Value="42" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="HubEyebrowStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMetricLabelStyle}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBright}" />
    </Style>
    <Style x:Key="HubSetupCardStyle" TargetType="Border" BasedOn="{StaticResource HubSurfaceStyle}">
        <Setter Property="Background" Value="{DynamicResource BrushFillTertiary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimarySoft}" />
    </Style>
    <Style x:Key="HubSectionCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="22,4,22,20" />
    </Style>
    <Style x:Key="HubSectionExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Style="{StaticResource HubSurfaceStyle}" Padding="0">
                        <StackPanel>
                            <ToggleButton x:Name="SectionToggle" Padding="22,18"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Style="{DynamicResource HubSectionHeaderStyle}" />
                            <ContentPresenter x:Name="SectionContent" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="SectionContent" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HubChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource BrushFillTertiary}" />
        <Setter Property="Padding" Value="9,5" />
    </Style>
    <Style x:Key="HubReportBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushFillTertiary}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style x:Key="HubReportTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HubBodyStyle}">
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style x:Key="HubFishingBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushPrimarySoft}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>
    <Style x:Key="HubThinProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BrushSeparator}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2.5"
                            Height="{TemplateBinding Height}">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2.5"
                                Height="{TemplateBinding Height}" Background="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
