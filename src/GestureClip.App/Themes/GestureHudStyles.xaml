<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================
         数码方块流动渐变 · 基础表面
         深色底 + 千秋青环境光 + 青→靛→紫→品红的方块数据流
         =================================================================== -->
    <LinearGradientBrush x:Key="HudSurfaceGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF14121B" Offset="0" />
        <GradientStop Color="#FF1E1927" Offset="0.36" />
        <GradientStop Color="#FF211C2B" Offset="0.72" />
        <GradientStop Color="#FF14121B" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="HudAmbientGradient" Center="0.78,0.02" GradientOrigin="0.78,0.02"
                         RadiusX="0.9" RadiusY="1.7">
        <GradientStop Color="#248C769C" Offset="0" />
        <GradientStop Color="#00241C2C" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="HudSurfaceRim" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#54B3A1BD" Offset="0" />
        <GradientStop Color="#302E2637" Offset="0.52" />
        <GradientStop Color="#4A9A8295" Offset="1" />
    </LinearGradientBrush>

    <!-- 细密像素底噪：只提供一层几乎看不见的数码肌理 -->
    <DrawingBrush x:Key="HudPixelGridBrush" TileMode="Tile"
                  Viewport="0,0,7,7" ViewportUnits="Absolute"
                  AlignmentX="Left" AlignmentY="Top" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#0BCFEFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,3,3" RadiusX="0.8" RadiusY="0.8" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 大方块遮罩：流动渐变只存在于这些"数据块"内，形成数码方块流 -->
    <DrawingBrush x:Key="HudPixelMaskBrush" TileMode="Tile"
                  Viewport="0,0,12,12" ViewportUnits="Absolute"
                  AlignmentX="Left" AlignmentY="Top" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFFFFFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,6,6" RadiusX="1.5" RadiusY="1.5" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- XP 分段方块：轨道（暗）与填充遮罩（亮） -->
    <DrawingBrush x:Key="HudSegmentTrackBrush" TileMode="Tile"
                  Viewport="0,0,9,9" ViewportUnits="Absolute"
                  AlignmentX="Left" AlignmentY="Top" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#26FFFFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,5,5" RadiusX="1.2" RadiusY="1.2" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="HudSegmentMaskBrush" TileMode="Tile"
                  Viewport="0,0,9,9" ViewportUnits="Absolute"
                  AlignmentX="Left" AlignmentY="Top" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFFFFFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,5,5" RadiusX="1.2" RadiusY="1.2" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 卡片内 1px 渐变分隔线 -->
    <LinearGradientBrush x:Key="HudDividerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0038E0D0" Offset="0" />
        <GradientStop Color="#5238E0D0" Offset="0.16" />
        <GradientStop Color="#2E7E8BF8" Offset="0.58" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HudTopHighlightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#4DEAFBFF" Offset="0.2" />
        <GradientStop Color="#33A5C8F0" Offset="0.62" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Segoe UI Emoji, Segoe UI Symbol" />
        <Setter Property="Foreground" Value="#FFF1F5F9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="HudLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="#FFC2B7CB" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="HudMonoText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="HudStatLabel" TargetType="TextBlock" BasedOn="{StaticResource HudLabel}">
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HudStatValue" TargetType="TextBlock" BasedOn="{StaticResource HudMonoText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HudActionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Text" Value="{Binding ActionName}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Pattern}" Value="-">
                <Setter Property="Text" Value="正在识别手势" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HudActionDetails" TargetType="StackPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActionName}" Value="未绑定">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Pattern}" Value="-">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="HudReleaseHint" TargetType="TextBlock" BasedOn="{StaticResource HudLabel}">
        <Setter Property="Text" Value="松开右键执行" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActionName}" Value="未绑定">
                <Setter Property="Text" Value="可在设置中绑定" />
                <Setter Property="Foreground" Value="#FFEAC8A8" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Pattern}" Value="-">
                <Setter Property="Text" Value="划动以识别手势" />
                <Setter Property="Foreground" Value="#FFCBD5E1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- XP 条：分段方块 LED 风格，填充色跟随 HudAccentBrush -->
    <Style x:Key="HudXpProgress" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Height="{TemplateBinding Height}" Background="Transparent">
                        <Border x:Name="PART_Track"
                                Height="{TemplateBinding Height}"
                                Background="{StaticResource HudSegmentTrackBrush}"
                                CornerRadius="3.5" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Height="{TemplateBinding Height}"
                                CornerRadius="3.5"
                                Background="{TemplateBinding Foreground}"
                                OpacityMask="{StaticResource HudSegmentMaskBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HudPatternRow" TargetType="StackPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Pattern}" Value="-"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="HudShortcutBadge" TargetType="Border">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShortcutText}" Value="暂无动作"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding ShortcutText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
