<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================
         数码方块流动渐变 · 基础表面
         深色底 + 千秋青环境光 + 青→靛→紫→品红的方块数据流
         =================================================================== -->
    <LinearGradientBrush x:Key="HudSurfaceGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF03070E" Offset="0" />
        <GradientStop Color="#FF0A2434" Offset="0.36" />
        <GradientStop Color="#FF1B1A3C" Offset="0.72" />
        <GradientStop Color="#FF03070E" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="HudAmbientGradient" Center="0.78,0.02" GradientOrigin="0.78,0.02"
                         RadiusX="0.9" RadiusY="1.7">
        <GradientStop Color="#305CCDD3" Offset="0" />
        <GradientStop Color="#001B3C4B" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="HudSurfaceRim" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#9CBBDCF0" Offset="0" />
        <GradientStop Color="#1C4C6384" Offset="0.52" />
        <GradientStop Color="#5C38E0D0" Offset="1" />
    </LinearGradientBrush>

    <!-- 细密像素底噪：只提供一层几乎看不见的数码肌理 -->
    <DrawingBrush x:Key="HudPixelGridBrush" TileMode="Tile"
                  Viewport="0,0,7,7" ViewportUnits="Absolute"
                  AlignmentX="Left" AlignmentY="Top" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#0BCFEFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,3,3" RadiusX="0.8" RadiusY="0.8" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 大方块遮罩：流动渐变只存在于这些"数据块"内，形成数码方块流 -->
    <DrawingBrush x:Key="HudPixelMaskBrush" TileMode="Tile"
                  Viewport="0,0,12,12" ViewportUnits="Absolute"
                  AlignmentX="Left" AlignmentY="Top" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFFFFFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,6,6" RadiusX="1.5" RadiusY="1.5" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- XP 分段方块：轨道（暗）与填充遮罩（亮） -->
    <DrawingBrush x:Key="HudSegmentTrackBrush" TileMode="Tile"
                  Viewport="0,0,9,9" ViewportUnits="Absolute"
                  AlignmentX="Left" AlignmentY="Top" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#26FFFFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,5,5" RadiusX="1.2" RadiusY="1.2" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="HudSegmentMaskBrush" TileMode="Tile"
                  Viewport="0,0,9,9" ViewportUnits="Absolute"
                  AlignmentX="Left" AlignmentY="Top" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFFFFFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,5,5" RadiusX="1.2" RadiusY="1.2" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 卡片内 1px 渐变分隔线 -->
    <LinearGradientBrush x:Key="HudDividerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0038E0D0" Offset="0" />
        <GradientStop Color="#5238E0D0" Offset="0.16" />
        <GradientStop Color="#2E7E8BF8" Offset="0.58" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HudTopHighlightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#4DEAFBFF" Offset="0.2" />
        <GradientStop Color="#33A5C8F0" Offset="0.62" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HudChipGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#18FFFFFF" Offset="0" />
        <GradientStop Color="#05FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Segoe UI Emoji, Segoe UI Symbol" />
        <Setter Property="Foreground" Value="#FFF1F5F9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="HudLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="#FF94A3B8" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="HudMonoText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="HudStatChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HudChipGradient}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="HudStatLabel" TargetType="TextBlock" BasedOn="{StaticResource HudLabel}">
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HudStatValue" TargetType="TextBlock" BasedOn="{StaticResource HudMonoText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HudReleaseHint" TargetType="TextBlock" BasedOn="{StaticResource HudLabel}">
        <Setter Property="Text" Value="松开右键执行" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActionName}" Value="未绑定">
                <Setter Property="Text" Value="未绑定动作" />
                <Setter Property="Foreground" Value="#FFFBBF24" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Pattern}" Value="-">
                <Setter Property="Text" Value="划动以识别手势" />
                <Setter Property="Foreground" Value="#FFCBD5E1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- XP 条：分段方块 LED 风格，填充色跟随 HudAccentBrush -->
    <Style x:Key="HudXpProgress" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Height="{TemplateBinding Height}" Background="Transparent">
                        <Border x:Name="PART_Track"
                                Height="{TemplateBinding Height}"
                                Background="{StaticResource HudSegmentTrackBrush}"
                                CornerRadius="3.5" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Height="{TemplateBinding Height}"
                                CornerRadius="3.5"
                                Background="{TemplateBinding Foreground}"
                                OpacityMask="{StaticResource HudSegmentMaskBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
