<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Segoe UI Emoji, Segoe UI Symbol" />
        <Setter Property="Foreground" Value="#FFF1F5F9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="HudLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="#FF94A3B8" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="HudMonoText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="HudStatChip" TargetType="Border">
        <Setter Property="Background" Value="#0CFFFFFF" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="BorderBrush" Value="#14FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="HudStatLabel" TargetType="TextBlock" BasedOn="{StaticResource HudLabel}">
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="HudStatValue" TargetType="TextBlock" BasedOn="{StaticResource HudMonoText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="HudReleaseHint" TargetType="TextBlock" BasedOn="{StaticResource HudLabel}">
        <Setter Property="Text" Value="松开右键执行" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActionName}" Value="未绑定">
                <Setter Property="Text" Value="未绑定动作" />
                <Setter Property="Foreground" Value="#FFFBBF24" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Pattern}" Value="-">
                <Setter Property="Text" Value="划动以识别手势" />
                <Setter Property="Foreground" Value="#FFCBD5E1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="HudXpProgress" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="#18FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}" CornerRadius="1.5">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1.5"
                                Height="{TemplateBinding Height}" Background="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
