<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackgroundDark}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurfaceDark}" />
    <SolidColorBrush x:Key="BrushGlass" Color="{StaticResource ColorGlassDark}" />
    <SolidColorBrush x:Key="BrushGlassStrong" Color="{StaticResource ColorGlassStrongDark}" />
    <SolidColorBrush x:Key="BrushGlassLight" Color="{StaticResource ColorGlassLight}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorderDark}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimarySoft" Color="{StaticResource ColorPrimarySoft}" />
    <SolidColorBrush x:Key="BrushPrimaryBright" Color="{StaticResource ColorPrimaryBright}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushDangerSoft" Color="{StaticResource ColorDangerSoft}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimaryDark}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondaryDark}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMutedDark}" />
    <SolidColorBrush x:Key="BrushControlHover" Color="{StaticResource ColorControlHover}" />
    <SolidColorBrush x:Key="BrushControlSelected" Color="{StaticResource ColorControlSelected}" />
    <SolidColorBrush x:Key="BrushControlDisabled" Color="{StaticResource ColorControlDisabled}" />
    <SolidColorBrush x:Key="BrushComboBoxDropDown" Color="{StaticResource ColorComboBoxDropDown}" />
    <SolidColorBrush x:Key="BrushTabSelected" Color="{StaticResource ColorTabSelected}" />
    <SolidColorBrush x:Key="BrushTabSelectedText" Color="{StaticResource ColorTabSelectedText}" />
    <SolidColorBrush x:Key="BrushTabIdle" Color="{StaticResource ColorTabIdle}" />
    <SolidColorBrush x:Key="BrushDarkPanel" Color="{StaticResource ColorDarkPanel}" />
    <SolidColorBrush x:Key="BrushDarkPanelSoft" Color="{StaticResource ColorDarkPanelSoft}" />
    <SolidColorBrush x:Key="BrushCoral" Color="{StaticResource ColorCoral}" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushSeparator" Color="{StaticResource ColorSeparator}" />
    <SolidColorBrush x:Key="BrushFillTertiary" Color="{StaticResource ColorFillTertiary}" />
    <SolidColorBrush x:Key="BrushTrafficClose" Color="{StaticResource ColorTrafficClose}" />
    <SolidColorBrush x:Key="BrushTrafficYellow" Color="{StaticResource ColorTrafficYellow}" />
    <SolidColorBrush x:Key="BrushTrafficGreen" Color="{StaticResource ColorTrafficGreen}" />
    <SolidColorBrush x:Key="BrushTrafficMinimize" Color="{StaticResource ColorTrafficYellow}" />
    <SolidColorBrush x:Key="BrushTrafficMaximize" Color="{StaticResource ColorTrafficGreen}" />
    <SolidColorBrush x:Key="BrushCardElevated" Color="{StaticResource ColorCardElevated}" />
    <SolidColorBrush x:Key="BrushFocusRing" Color="{StaticResource ColorFocusRing}" />
    <SolidColorBrush x:Key="BrushSegmentSelected" Color="{StaticResource ColorSegmentSelected}" />
    <SolidColorBrush x:Key="BrushListHover" Color="{StaticResource ColorListHover}" />
    <SolidColorBrush x:Key="BrushListSelectedHover" Color="{StaticResource ColorListSelectedHover}" />
    <SolidColorBrush x:Key="BrushButtonFill" Color="{StaticResource ColorButtonFill}" />
    <SolidColorBrush x:Key="BrushButtonHover" Color="{StaticResource ColorButtonHover}" />
    <SolidColorBrush x:Key="BrushRailBackground" Color="{StaticResource ColorRailBackground}" />
    <SolidColorBrush x:Key="BrushContentBackground" Color="{StaticResource ColorContentBackground}" />
    <SolidColorBrush x:Key="BrushHintYellow" Color="{StaticResource ColorHintYellow}" />
    <SolidColorBrush x:Key="BrushBackdropWash" Color="{StaticResource ColorBackdropWash}" />

    <!-- Hub metric tiles -->
    <LinearGradientBrush x:Key="BrushTileBlueBg" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="{StaticResource ColorTileBlueBgTop}" Offset="0" />
        <GradientStop Color="{StaticResource ColorTileBlueBgBottom}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrushTileBlueBorder" Color="{StaticResource ColorTileBlueBorder}" />
    <SolidColorBrush x:Key="BrushTileBlueLabel" Color="{StaticResource ColorTileBlueLabel}" />
    <SolidColorBrush x:Key="BrushTileBlueValue" Color="{StaticResource ColorTileBlueValue}" />
    <LinearGradientBrush x:Key="BrushTileGreenBg" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="{StaticResource ColorTileGreenBgTop}" Offset="0" />
        <GradientStop Color="{StaticResource ColorTileGreenBgBottom}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrushTileGreenBorder" Color="{StaticResource ColorTileGreenBorder}" />
    <SolidColorBrush x:Key="BrushTileGreenLabel" Color="{StaticResource ColorTileGreenLabel}" />
    <SolidColorBrush x:Key="BrushTileGreenValue" Color="{StaticResource ColorTileGreenValue}" />
    <LinearGradientBrush x:Key="BrushTileAmberBg" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="{StaticResource ColorTileAmberBgTop}" Offset="0" />
        <GradientStop Color="{StaticResource ColorTileAmberBgBottom}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrushTileAmberBorder" Color="{StaticResource ColorTileAmberBorder}" />
    <SolidColorBrush x:Key="BrushTileAmberLabel" Color="{StaticResource ColorTileAmberLabel}" />
    <SolidColorBrush x:Key="BrushTileAmberValue" Color="{StaticResource ColorTileAmberValue}" />
    <SolidColorBrush x:Key="BrushBrandNavy" Color="{StaticResource ColorBrandNavy}" />
    <SolidColorBrush x:Key="BrushBrandRed" Color="{StaticResource ColorBrandRed}" />
    <SolidColorBrush x:Key="BrushBrandYellow" Color="{StaticResource ColorBrandYellow}" />
    <SolidColorBrush x:Key="BrushBrandSilver" Color="{StaticResource ColorBrandSilver}" />

    <!-- Soft ambient wash — themeable via Colors*.xaml -->
    <SolidColorBrush x:Key="BrushAppBackgroundSolid" Color="{StaticResource ColorAppBg1}" />
    <LinearGradientBrush x:Key="BrushAppBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ColorAppBg0}" Offset="0" />
        <GradientStop Color="{StaticResource ColorAppBg1}" Offset="0.45" />
        <GradientStop Color="{StaticResource ColorAppBg2}" Offset="1" />
    </LinearGradientBrush>

    <!-- Liquid glass: specular rim border (bright top edge fading down) -->
    <LinearGradientBrush x:Key="BrushGlassRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ColorGlassRimTop}" Offset="0" />
        <GradientStop Color="{StaticResource ColorGlassRimBottom}" Offset="0.6" />
        <GradientStop Color="{StaticResource ColorGlassRimBottom}" Offset="1" />
    </LinearGradientBrush>
    <!-- Inner top sheen laid over glass surfaces (non-hit-test overlay) -->
    <LinearGradientBrush x:Key="BrushGlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ColorGlassSheen}" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.38" />
    </LinearGradientBrush>
    <!-- Ambient washes behind glass surfaces -->
    <RadialGradientBrush x:Key="BrushAmbientBlue" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="{StaticResource ColorAmbientBlue}" Offset="0" />
        <GradientStop Color="#003B82F6" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BrushAmbientViolet" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="{StaticResource ColorAmbientViolet}" Offset="0" />
        <GradientStop Color="#008B5CF6" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BrushAmbientTeal" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="{StaticResource ColorAmbientTeal}" Offset="0" />
        <GradientStop Color="#002DD4BF" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="BrushGlassHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ColorGlassTop}" Offset="0" />
        <GradientStop Color="{StaticResource ColorGlassMid}" Offset="0.55" />
        <GradientStop Color="{StaticResource ColorGlassBottom}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushTabSelectedGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ColorTabSelected}" Offset="0" />
        <GradientStop Color="{StaticResource ColorControlHover}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPrimaryGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#60A5FA" Offset="0" />
        <GradientStop Color="#3B82F6" Offset="0.55" />
        <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrushPrimarySolid" Color="{StaticResource ColorPrimaryBright}" />
    <SolidColorBrush x:Key="BrushPrimarySolidHover" Color="#2563EB" />
    <SolidColorBrush x:Key="BrushPrimarySolidPressed" Color="#1D4ED8" />

    <LinearGradientBrush x:Key="BrushCoralGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8A7A" Offset="0" />
        <GradientStop Color="#FF6B5A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushOverlayPanel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource ColorOverlayTop}" Offset="0" />
        <GradientStop Color="{StaticResource ColorOverlayBottom}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushSidebarBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D0E8ECF1" Offset="0" />
        <GradientStop Color="#B8E2E8F0" Offset="0.55" />
        <GradientStop Color="#A8DCE3EB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushGlassPanel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#D9FFFFFF" Offset="0.5" />
        <GradientStop Color="#C8F8FAFC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushGlassCard" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5FFFFFF" Offset="0" />
        <GradientStop Color="#E0FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushGlassAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CCDBEAFE" Offset="0" />
        <GradientStop Color="#B8EFF6FF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
