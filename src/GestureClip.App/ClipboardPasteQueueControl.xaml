<UserControl x:Class="GestureClip.App.ClipboardPasteQueueControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="QueueVisibility"/>
    </UserControl.Resources>
    <Border Padding="10" Visibility="{Binding HasPasteQueue, Converter={StaticResource QueueVisibility}}">
        <StackPanel>
            <TextBlock Text="{Binding PasteQueueText}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="重试" IsEnabled="{Binding CanRecoverPasteQueue}" Click="OnRetry" Padding="10,3"/>
                <Button Content="跳过" IsEnabled="{Binding CanRecoverPasteQueue}" Click="OnSkip" Padding="10,3" Margin="6,0,0,0"/>
                <Button Content="取消队列" Click="OnCancel" Padding="10,3" Margin="6,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
