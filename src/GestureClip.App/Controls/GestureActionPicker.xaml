<UserControl x:Class="GestureClip.App.Controls.GestureActionPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460" Height="460" PreviewKeyDown="Picker_PreviewKeyDown">
    <Border Background="{DynamicResource BrushCardElevated}" BorderBrush="{DynamicResource BrushPrimaryBright}"
            BorderThickness="1" CornerRadius="16" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="关闭" Width="60" MinWidth="0" Height="28"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click" />
                <StackPanel>
                    <TextBlock Text="更换动作" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Card.DirectionText}" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding Card.ActionName, StringFormat=当前：{0}}"
                       Margin="0,12,0,10" Foreground="{DynamicResource BrushPrimaryBright}" />
            <Grid Grid.Row="2" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Height="36"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="搜索动作" ToolTip="搜索名称、分类或快捷键" />
            <TextBlock Text="搜索动作名称、分类或快捷键" IsHitTestVisible="False" Margin="12,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </Grid>
            <ListBox x:Name="ActionList" Grid.Row="3" ItemsSource="{Binding FilteredOptions}"
                     BorderThickness="0" Background="Transparent" SelectedValuePath="Action"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                Padding="10,8" Margin="0,0,0,4" MinWidth="0" Height="Auto"
                                Tag="{Binding}" Click="ChooseAction_Click" Background="{DynamicResource BrushFillTertiary}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" FontFamily="Consolas"
                                               FontSize="11" Margin="10,0,0,0" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="{Binding Category}" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="4" Text="{Binding ResultText}" FontSize="11" Margin="0,10,0,0"
                       Foreground="{DynamicResource BrushTextSecondary}" />
        </Grid>
    </Border>
</UserControl>
