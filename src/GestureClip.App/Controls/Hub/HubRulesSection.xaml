<UserControl x:Class="GestureClip.App.Controls.Hub.HubRulesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Expander Header="工作规则设置"
                  IsExpanded="{Binding SettingsExpanded, Mode=TwoWay}"
                  Style="{DynamicResource HubSectionExpanderStyle}">
            <Border Style="{DynamicResource HubSectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="工作日：0=周日，1=周一 … 6=周六。未填月薪时收益显示 ¥0.00，不会崩溃。"
                               Style="{DynamicResource HubBodyStyle}"
                               Margin="0,0,0,12" />
                    <TextBlock Text="工作制模板" Style="{DynamicResource HubMetricLabelStyle}" />
                    <ItemsControl ItemsSource="{Binding WorkTemplateOptions}" Margin="0,6,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Style="{DynamicResource HubSecondaryButtonStyle}"
                                        Command="{Binding DataContext.ApplyWorkTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,8,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,10">
                            <TextBlock Text="月薪" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBox Text="{Binding WorkstationMonthlySalary, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="仅本地估算" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,10">
                            <TextBlock Text="发薪日（1-28）" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBox Text="{Binding WorkstationPayday, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,10">
                            <TextBlock Text="上班时间" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBox Text="{Binding WorkstationWorkStartTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="HH:mm" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,10">
                            <TextBlock Text="下班时间" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBox Text="{Binding WorkstationWorkEndTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="HH:mm" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,10">
                            <TextBlock Text="午休开始" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBox Text="{Binding WorkstationLunchStartTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,10">
                            <TextBlock Text="午休结束" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBox Text="{Binding WorkstationLunchEndTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="工作日" Style="{DynamicResource HubMetricLabelStyle}" />
                    <TextBox Text="{Binding WorkstationWorkdays, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Margin="0,4,0,10"
                             ToolTip="例如 1,2,3,4,5 表示周一到周五" />
                    <TextBlock Text="文案风格" Style="{DynamicResource HubMetricLabelStyle}" />
                    <ComboBox ItemsSource="{Binding WorkBearTextStyleOptions}"
                              SelectedItem="{Binding WorkBearTextStyle, Mode=TwoWay}"
                              Margin="0,4,0,12"
                              ToolTip="正常 / 打工人 / 抽象，三种语气" />
                    <CheckBox Content="HUD 动作彩蛋文案（可关）"
                              IsChecked="{Binding HudFunEnabled, Mode=TwoWay}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="快捷动作成功时加 XP（可关）"
                              IsChecked="{Binding GestureXpBonusEnabled, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>

