<UserControl x:Class="GestureClip.App.Controls.Hub.HubRestSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Expander Header="休息提醒"
                  IsExpanded="{Binding RestExpanded, Mode=TwoWay}"
                  Style="{DynamicResource HubSectionExpanderStyle}">
            <Border Style="{DynamicResource HubSectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="温柔提醒，可稍后、可关闭。离开电脑几分钟会自动算休息（只看键鼠是否空闲，不看你在用什么）。"
                               Style="{DynamicResource HubBodyStyle}"
                               Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ContinuousWorkText, StringFormat=已连续工作 {0}}"
                               Style="{DynamicResource HubRootTextStyle}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NextRestReminderText, StringFormat=下次提醒 {0}}"
                               Style="{DynamicResource HubBodyStyle}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding RestReminderLimitText}"
                               Style="{DynamicResource HubBodyStyle}"
                               Margin="0,4,0,0" />
                    <Border Background="{Binding RestRiskSoftBrush}"
                            BorderBrush="{Binding RestRiskBrush}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,4"
                            Margin="0,10,0,14"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding RestRiskText, StringFormat=当前节奏：{0}}"
                                   Style="{DynamicResource HubRootTextStyle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding RestRiskBrush}" />
                    </Border>
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="每日上限" Style="{DynamicResource HubMetricLabelStyle}" />
                            <ComboBox ItemsSource="{Binding RestReminderMaxOptions}"
                                      SelectedItem="{Binding RestReminderMaxPerDay, Mode=TwoWay}"
                                      Margin="0,4,0,0"
                                      ToolTip="一天最多弹几次" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="每周上限" Style="{DynamicResource HubMetricLabelStyle}" />
                            <ComboBox ItemsSource="{Binding RestReminderWeekMaxOptions}"
                                      SelectedItem="{Binding RestReminderMaxPerWeek, Mode=TwoWay}"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="最少连续（分钟）" Style="{DynamicResource HubMetricLabelStyle}" />
                            <ComboBox ItemsSource="{Binding RestReminderMinContinuousOptions}"
                                      SelectedItem="{Binding RestReminderMinContinuousMinutes, Mode=TwoWay}"
                                      Margin="0,4,0,0"
                                      ToolTip="连续工作满该分钟才提醒" />
                        </StackPanel>
                    </UniformGrid>
                    <Border Height="1" Background="{DynamicResource BrushSeparator}" Margin="0,2,0,12" />
                    <TextBlock Text="健康小提醒（工作时段内，温柔不轰炸）"
                               Style="{DynamicResource HubMetricLabelStyle}"
                               Margin="0,0,0,8" />
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,8,0">
                            <CheckBox Content="💧 喝水提醒"
                                      IsChecked="{Binding WaterReminderEnabled, Mode=TwoWay}" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="每隔(分)" Style="{DynamicResource HubMetricLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="80"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding WaterIntervalOptions}"
                                          SelectedItem="{Binding WaterReminderIntervalMinutes, Mode=TwoWay}"
                                          IsEnabled="{Binding WaterReminderEnabled}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <CheckBox Content="🧘 拉伸提醒"
                                      IsChecked="{Binding StretchReminderEnabled, Mode=TwoWay}" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="每隔(分)" Style="{DynamicResource HubMetricLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="80"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding StretchIntervalOptions}"
                                          SelectedItem="{Binding StretchReminderIntervalMinutes, Mode=TwoWay}"
                                          IsEnabled="{Binding StretchReminderEnabled}" />
                            </DockPanel>
                        </StackPanel>
                    </UniformGrid>
                    <WrapPanel>
                        <Button Content="稍后提醒"
                                Style="{DynamicResource HubSecondaryButtonStyle}"
                                Command="{Binding SnoozeRestReminderCommand}"
                                Margin="0,0,10,8" />
                        <Button Content="{Binding RestReminderButtonText}"
                                Style="{DynamicResource HubSecondaryButtonStyle}"
                                Command="{Binding ToggleRestReminderCommand}"
                                Margin="0,0,10,8" />
                        <Button Content="关闭提醒"
                                Style="{DynamicResource HubSecondaryButtonStyle}"
                                Command="{Binding DisableRestReminderCommand}"
                                Margin="0,0,10,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>

