<UserControl x:Class="GestureClip.App.Controls.Hub.HubFishingSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Expander Header="摸鱼模式"
                  IsExpanded="{Binding FishingExpanded, Mode=TwoWay}"
                  Style="{DynamicResource HubSectionExpanderStyle}">
            <Border Style="{DynamicResource HubSectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="只记录你手动开始 / 结束。不识别网页或应用，放心用。"
                               Style="{DynamicResource HubBodyStyle}"
                               Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="本次计时" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBlock Text="{Binding CurrentFishingText}" Style="{DynamicResource HubRootTextStyle}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentFishingValueText, StringFormat=约值 {0}}"
                                       Style="{DynamicResource HubBodyStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="今日累计" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBlock Text="{Binding TodayFishingDurationText}" Style="{DynamicResource HubRootTextStyle}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TodayFishingValueText, StringFormat=约值 {0}}"
                                       Style="{DynamicResource HubBodyStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="{Binding FishingButtonText}"
                                Style="{DynamicResource HubPrimaryButtonStyle}"
                                Command="{Binding ToggleFishingCommand}"
                                Margin="0,0,10,0"
                                MinWidth="120" />
                        <Button Content="清除今日摸鱼"
                                Style="{DynamicResource HubSecondaryButtonStyle}"
                                Command="{Binding ClearFishingCommand}"
                                ToolTip="只清摸鱼记录，不影响复制粘贴统计" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>

