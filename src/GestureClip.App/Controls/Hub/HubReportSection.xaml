<UserControl x:Class="GestureClip.App.Controls.Hub.HubReportSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Expander Header="今日生存报告"
                  IsExpanded="{Binding ReportExpanded, Mode=TwoWay}"
                  Style="{DynamicResource HubSectionExpanderStyle}">
            <Border Style="{DynamicResource HubSectionCardStyle}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="今日评级" Style="{DynamicResource HubMetricLabelStyle}" />
                        <Border DockPanel.Dock="Right"
                                Style="{DynamicResource HubChipStyle}"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding DailyRatingText}"
                                       Style="{DynamicResource HubRootTextStyle}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushPrimaryBright}" />
                        </Border>
                    </DockPanel>
                    <Border Style="{DynamicResource HubReportBlockStyle}">
                        <TextBlock Text="{Binding DailyReportDisplayText}"
                                   Style="{DynamicResource HubReportTextStyle}"
                                   MinHeight="48" />
                    </Border>
                    <DockPanel Margin="0,14,0,10">
                        <TextBlock Text="分享卡片样式"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource HubMetricLabelStyle}" />
                        <ComboBox Width="148"
                                  HorizontalAlignment="Right"
                                  ItemsSource="{Binding ShareCardStyleOptions}"
                                  SelectedItem="{Binding ShareCardStyle, Mode=TwoWay}"
                                  ToolTip="仅本地 PNG，不含剪贴板正文" />
                    </DockPanel>
                    <WrapPanel>
                        <Button Content="生成今日报告"
                                Style="{DynamicResource HubPrimaryButtonStyle}"
                                Command="{Binding GenerateReportCommand}"
                                Margin="0,0,10,8" />
                        <Button Content="生成 PNG 卡片"
                                Style="{DynamicResource HubSecondaryButtonStyle}"
                                Command="{Binding GenerateShareCardCommand}"
                                Margin="0,0,10,8" />
                        <Button Content="打开卡片文件夹"
                                Style="{DynamicResource HubSecondaryButtonStyle}"
                                Command="{Binding OpenLastShareCardFolderCommand}"
                                Margin="0,0,10,8" />
                        <Button Content="{Binding AutoDailyReportButtonText}"
                                Style="{DynamicResource HubSecondaryButtonStyle}"
                                Command="{Binding ToggleAutoDailyReportCommand}"
                                Margin="0,0,10,8" />
                        <Button Content="今天不再显示"
                                Style="{DynamicResource HubSecondaryButtonStyle}"
                                Command="{Binding MuteDailyReportTodayCommand}"
                                Margin="0,0,10,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>

