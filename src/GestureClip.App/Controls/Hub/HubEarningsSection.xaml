<UserControl x:Class="GestureClip.App.Controls.Hub.HubEarningsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Expander Header="收益与效率"
                  IsExpanded="{Binding EarningsExpanded, Mode=TwoWay}"
                  Style="{DynamicResource HubSectionExpanderStyle}">
            <Border Style="{DynamicResource HubSectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding SalaryHintText}" Style="{DynamicResource HubBodyStyle}" Margin="0,0,0,12" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,10,12">
                            <TextBlock Text="老板今日已支出" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBlock Text="{Binding BossPaidText}" Style="{DynamicResource HubMetricValueStyle}" FontSize="22" />
                        </StackPanel>
                        <StackPanel Margin="10,0,0,12">
                            <TextBlock Text="每分钟约值" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBlock Text="{Binding MinuteValueText}" Style="{DynamicResource HubMetricValueStyle}" FontSize="22" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="距发薪日还剩" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBlock Text="{Binding PaydayText}" Style="{DynamicResource HubRootTextStyle}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="今日动作统计" Style="{DynamicResource HubMetricLabelStyle}" />
                            <TextBlock Text="{Binding ActionStatsText}"
                                       Style="{DynamicResource HubRootTextStyle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                        </StackPanel>
                    </UniformGrid>
        
                    <!-- 7-day action mini bar chart: single accent series, today emphasized -->
                    <TextBlock Text="本周动作走势（复制 + 粘贴 + 手势）"
                               Style="{DynamicResource HubMetricLabelStyle}"
                               Margin="0,14,0,6" />
                    <ItemsControl ItemsSource="{Binding WeeklyTrend}" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="34" ToolTip="{Binding TooltipText}" Background="Transparent">
                                    <Grid Height="48">
                                        <Border x:Name="TrendBar"
                                                Width="14"
                                                Height="{Binding BarHeight}"
                                                CornerRadius="3,3,0,0"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource BrushPrimaryBright}"
                                                Opacity="0.45" />
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BrushSeparator}" Margin="2,0" />
                                    <TextBlock x:Name="TrendDayLabel"
                                               Text="{Binding DayLabel}"
                                               Style="{DynamicResource HubMetricLabelStyle}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="TrendBar" Property="Opacity" Value="1" />
                                        <Setter TargetName="TrendDayLabel" Property="Foreground" Value="{DynamicResource BrushPrimaryBright}" />
                                        <Setter TargetName="TrendDayLabel" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>

