<UserControl x:Class="GestureClip.App.Controls.Hub.HubSprintSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Expander Header="下班冲刺"
                  IsExpanded="{Binding SprintExpanded, Mode=TwoWay}"
                  Style="{DynamicResource HubSectionExpanderStyle}">
            <Border Style="{DynamicResource HubSectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding ProtectionHintText}" Style="{DynamicResource HubBodyStyle}" />
                    <TextBlock Text="{Binding SprintSuggestionText}"
                               Style="{DynamicResource HubRootTextStyle}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                    <TextBlock Text="{Binding SprintCountdownText, StringFormat=距离下班 {0}}"
                               Style="{DynamicResource HubBodyStyle}"
                               Margin="0,8,0,12" />
                    <WrapPanel>
                        <Button Content="开启冲刺"
                                Style="{DynamicResource HubPrimaryButtonStyle}"
                                Command="{Binding StartSprintCommand}"
                                Margin="0,0,10,0" />
                        <Button Content="结束冲刺"
                                Style="{DynamicResource HubSecondaryButtonStyle}"
                                Command="{Binding StopSprintCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>

