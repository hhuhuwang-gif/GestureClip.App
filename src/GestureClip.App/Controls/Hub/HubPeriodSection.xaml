<UserControl x:Class="GestureClip.App.Controls.Hub.HubPeriodSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Expander Header="周报 / 月报（本地）"
                  IsExpanded="{Binding PeriodExpanded, Mode=TwoWay}"
                  Style="{DynamicResource HubSectionExpanderStyle}">
            <Border Style="{DynamicResource HubSectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="只汇总本机统计，不上传。适合周五回顾，或月底看看自己有多拼。"
                               Style="{DynamicResource HubBodyStyle}"
                               Margin="0,0,0,12" />
                    <TextBlock Text="{Binding PeriodReportText}" Style="{DynamicResource HubBodyStyle}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="生成本周总结"
                                Style="{DynamicResource HubPrimaryButtonStyle}"
                                Command="{Binding GenerateWeeklyReportCommand}"
                                Margin="0,0,10,0" />
                        <Button Content="近 30 天总结"
                                Style="{DynamicResource HubSecondaryButtonStyle}"
                                Command="{Binding GenerateMonthlyReportCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>

