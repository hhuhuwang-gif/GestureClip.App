<UserControl x:Class="GestureClip.App.Controls.Hub.HubQuickPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GestureClip.App.Controls">
    <StackPanel>
        <Border Style="{DynamicResource HubSurfaceStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="常用操作" Style="{DynamicResource HubRootTextStyle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                <Button Content="{Binding FishingButtonText}" Command="{Binding ToggleFishingCommand}"
                        Style="{DynamicResource HubPrimaryButtonStyle}" Margin="0,0,0,8" HorizontalContentAlignment="Center" />
                <Button Content="稍后提醒休息" Command="{Binding SnoozeRestReminderCommand}"
                        Style="{DynamicResource HubSecondaryButtonStyle}" Margin="0,0,0,8" />
                <Button Content="生成今日报告" Command="{Binding GenerateReportCommand}" Tag="Report"
                        Style="{DynamicResource HubSecondaryButtonStyle}" />
                <TextBlock Text="仅本地计时，不读取应用内容。" Style="{DynamicResource HubMetricLabelStyle}" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource HubSurfaceStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="工作日进度" Style="{DynamicResource HubRootTextStyle}" FontSize="16" FontWeight="SemiBold" />
                <Grid Width="112" Height="112" Margin="0,18,0,12">
                    <controls:RingProgress Progress="{Binding WorkdayProgressPercent}" StrokeThickness="7"
                                           TrackBrush="{DynamicResource BrushSeparator}" ProgressBrush="{Binding StageAccentBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding WorkdayProgressPercent, StringFormat={}{0:0}%}" Style="{DynamicResource HubMetricValueStyle}"
                                   HorizontalAlignment="Center" FontSize="32" Margin="0" />
                        <TextBlock Text="今日已完成" Style="{DynamicResource HubMetricLabelStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding SavedClicksText}" Style="{DynamicResource HubBodyStyle}" TextAlignment="Center" />
                <Border Height="1" Background="{DynamicResource BrushSeparator}" Margin="0,18" />
                <ItemsControl ItemsSource="{Binding HolidayCountdownTexts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{DynamicResource HubMetricLabelStyle}" Margin="0,0,0,7" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Padding="8,2">
            <StackPanel>
                <TextBlock Text="休息一下，也算进度" Style="{DynamicResource HubRootTextStyle}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ContinuousWorkText, StringFormat=已连续工作 {0}}" Style="{DynamicResource HubMetricLabelStyle}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding NextRestReminderText, StringFormat=下次提醒 {0}}" Style="{DynamicResource HubMetricLabelStyle}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
