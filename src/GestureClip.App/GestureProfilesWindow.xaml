<Window x:Class="GestureClip.App.GestureProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="按应用配置手势" Width="960" Height="680" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="按应用配置手势" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,12,0,20" TextWrapping="Wrap"
                   Text="默认关闭。按手势开始时捕获的目标进程精确匹配；只覆盖所列手势及绑定模式，其他手势继承现有全局绑定。动作选择“未绑定”表示在该应用明确禁用该手势。模板只填入草稿，需自行启用并保存。"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="新增配置" Click="NewProfile_Click" Margin="0,0,0,10" Padding="10"/>
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="ProcessName"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="进程名（例如 EXCEL.exe、chrome.exe、Code.exe）" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="选择程序…" Click="ChooseProgram_Click" Margin="8,0,0,0" Padding="10,5"/>
                        <TextBox x:Name="ProcessNameInput" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                    </DockPanel>
                    <CheckBox Content="启用此应用配置" IsChecked="{Binding IsEnabled}" Margin="0,12"/>
                    <WrapPanel Margin="0,0,0,12">
                        <TextBlock Text="可选模板：" VerticalAlignment="Center"/>
                        <Button Content="Excel" Click="Template_Click" Padding="10,5"/>
                        <Button Content="浏览器" Click="Template_Click" Padding="10,5" Margin="6,0"/>
                        <Button Content="编辑器" Click="Template_Click" Padding="10,5"/>
                    </WrapPanel>
                    <TextBlock Text="手势码：U ↑ / D ↓ / L ← / R →，可组合；R+L、WHEEL_UP、WHEEL_DOWN。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="添加覆盖" Click="AddBinding_Click" Padding="10,5"/>
                        <Button Content="移除选中覆盖" Click="RemoveBinding_Click" Margin="8,0,0,0" Padding="10,5"/>
                    </WrapPanel>
                </StackPanel>
                <DataGrid x:Name="BindingsGrid" ItemsSource="{Binding Bindings}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="手势码" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridCheckBoxColumn Header="左键增强模式" Binding="{Binding IsLeftButtonModified, UpdateSourceTrigger=PropertyChanged}" Width="115"/>
                        <DataGridTemplateColumn Header="动作" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="DisplayName" SelectedValuePath="Action"
                                              SelectedValue="{Binding Action, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="删除配置" Click="DeleteProfile_Click" Padding="14,8" Margin="8,0"/>
                <Button Content="保存配置" Click="SaveProfile_Click" Padding="20,8"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
