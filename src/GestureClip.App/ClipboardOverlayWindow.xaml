<Window x:Class="GestureClip.App.ClipboardOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板历史"
        Width="860"
        Height="760"
        MinWidth="420"
        MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#FF1F2126"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Shared list-row badge styles (one Style instance per badge type instead of
             one inline Style object per item per row → cheaper item templating) -->
        <Style x:Key="ListRowBadgeStyle" TargetType="Border" BasedOn="{StaticResource ModernBadgeStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="BadgePinnedStyle" TargetType="Border" BasedOn="{StaticResource ListRowBadgeStyle}">
            <Setter Property="Background" Value="#14FF9F0A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeSensitiveStyle" TargetType="Border" BasedOn="{StaticResource ListRowBadgeStyle}">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSensitive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeFavoriteStyle" TargetType="Border" BasedOn="{StaticResource ListRowBadgeStyle}">
            <Setter Property="Background" Value="#143478F6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeLinkStyle" TargetType="Border" BasedOn="{StaticResource ListRowBadgeStyle}">
            <Setter Property="Background" Value="#1414B8A6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLink}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeSessionCopiedStyle" TargetType="Border" BasedOn="{StaticResource ListRowBadgeStyle}">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSessionCopied}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Thumbnail frame: flat fill, no checker pattern -->
        <Style x:Key="ThumbnailFrameStyle" TargetType="Border">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource FillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dual preview text: text rows show preview, image rows show the image hint -->
        <Style x:Key="TextPreviewStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxHeight" Value="34" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ImageHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Type accent bar: blue/text · purple/image · orange/pin · green = 本会话已复制 -->
        <Style x:Key="TypeAccentBarStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,4,12,4" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter Property="Background" Value="#AF52DE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <!-- Last wins: multi-select copy progress is most actionable -->
                <DataTrigger Binding="{Binding IsSessionCopied}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder"
            CornerRadius="18"
            Margin="16"
            Padding="20,18,20,14"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title + three icons only -->
            <DockPanel Margin="2,0,2,12">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="AddSnippetButton"
                            Style="{StaticResource ModernLinkButtonStyle}"
                            Content="＋ 片段"
                            FontSize="12"
                            Padding="8,6"
                            Margin="0,0,8,0"
                            ToolTip="新建常用片段（支持 {date} {time} 等变量）"
                            Click="AddSnippetButton_Click" />
                    <Button x:Name="AlwaysVisibleButton"
                            Style="{StaticResource ModernIconButtonStyle}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE718;"
                            ToolTip="常显 / 取消常显"
                            Click="AlwaysVisibleButton_Click" />
                    <Button x:Name="ClearSearchButton"
                            Style="{StaticResource ModernIconButtonStyle}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE894;"
                            ToolTip="重置视图"
                            Click="ClearSearchButton_Click" />
                    <Button x:Name="ShortcutHelpButton"
                            Style="{StaticResource ModernIconButtonStyle}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE712;"
                            ToolTip="快捷键（F1）"
                            Click="ShortcutHelpButton_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="剪贴板历史"
                               Style="{StaticResource ModernPageTitleStyle}" />
                    <TextBlock Text="双击复制 · Enter 粘贴 · 拼音首字母搜索 · 绿条 = 本会话已复制"
                               Style="{StaticResource ModernSecondaryStyle}"
                               Margin="0,4,0,0"
                               ToolTip="左侧色条：蓝=文本 · 紫=图片 · 橙=置顶 · 绿=本会话已从历史复制。搜索支持拼音首字母（wx→微信）和 re: 正则。" />
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" LastChildFill="True">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource ModernSearchBoxStyle}"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="搜索历史：拼音首字母（wx→微信）· re: 正则"
                               FontSize="13"
                               Margin="18,0,18,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Style="{StaticResource ModernBadgeStyle}"
                            Padding="7,3"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <TextBlock Text="Ctrl + `"
                                   Style="{StaticResource ModernBadgeTextStyle}"
                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" />
                    </Border>
                </Grid>
            </DockPanel>

            <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
                <Border DockPanel.Dock="Left"
                        Style="{StaticResource ModernSegmentedBarStyle}"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="AllFilterButton"
                                     Style="{StaticResource ModernSegmentStyle}"
                                     Content="全部"
                                     Tag="All"
                                     IsChecked="True"
                                     Checked="FilterRadioButton_Checked" />
                        <RadioButton x:Name="PinnedFilterButton"
                                     Style="{StaticResource ModernSegmentStyle}"
                                     Content="固定"
                                     Tag="Pinned"
                                     Checked="FilterRadioButton_Checked" />
                        <RadioButton x:Name="FavoritesFilterButton"
                                     Style="{StaticResource ModernSegmentStyle}"
                                     Content="片段"
                                     Tag="Favorites"
                                     Checked="FilterRadioButton_Checked" />
                        <RadioButton x:Name="TextFilterButton"
                                     Style="{StaticResource ModernSegmentStyle}"
                                     Content="文本"
                                     Tag="Text"
                                     Checked="FilterRadioButton_Checked" />
                        <RadioButton x:Name="ImagesFilterButton"
                                     Style="{StaticResource ModernSegmentStyle}"
                                     Content="图片"
                                     Tag="Images"
                                     Checked="FilterRadioButton_Checked" />
                        <RadioButton x:Name="LinksFilterButton"
                                     Style="{StaticResource ModernSegmentStyle}"
                                     Content="链接"
                                     Tag="Links"
                                     Checked="FilterRadioButton_Checked" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <Grid Grid.Row="3" Margin="0,14,0,10">
                <Border Style="{StaticResource ModernSurfacePanelStyle}"
                        Padding="4">
                    <ListBox x:Name="HistoryList"
                             Margin="0"
                             AlternationCount="10"
                             SelectionMode="Extended"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.IsDeferredScrollingEnabled="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             SelectionChanged="HistoryList_SelectionChanged"
                             ScrollViewer.ScrollChanged="HistoryList_ScrollChanged"
                             PreviewMouseRightButtonDown="HistoryList_PreviewMouseRightButtonDown"
                             MouseDoubleClick="HistoryList_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Opened="ContextMenu_Opened"
                                         Closed="ContextMenu_Closed">
                                <MenuItem Header="粘贴选中并关闭" Click="PasteSelectedMenuItem_Click" InputGestureText="Enter" />
                                <MenuItem Header="复制选中" Click="CopySelectedMenuItem_Click" InputGestureText="Ctrl+C" />
                                <MenuItem Header="复制为纯文本" Click="CopyPlainTextMenuItem_Click" InputGestureText="Ctrl+Shift+C" />
                                <MenuItem Header="删除选中" Click="DeleteSelectedMenuItem_Click" InputGestureText="Delete" />
                                <Separator />
                                <MenuItem Header="{Binding SelectedPinActionText}" Click="TogglePinnedMenuItem_Click" InputGestureText="Ctrl+P" />
                                <MenuItem Header="{Binding SelectedFavoriteActionText}" Click="ToggleFavoriteMenuItem_Click" InputGestureText="Ctrl+S" />
                                <MenuItem Header="粘贴选中（不关闭）" Click="PasteKeepOpenMenuItem_Click" InputGestureText="Ctrl+Enter" />
                                <MenuItem Header="加入粘贴队列（按序连贴）" Click="EnqueuePasteQueueMenuItem_Click" InputGestureText="Ctrl+Q" />
                                <MenuItem Header="以文件形式复制（可粘贴到文件夹）" Click="CopyAsFilesMenuItem_Click" />
                                <MenuItem Header="编辑内容（仅文本）" Click="EditItemMenuItem_Click" InputGestureText="F2" />
                                <MenuItem Header="生成二维码（手机扫码带走）" Click="ShowQrMenuItem_Click" />
                                <MenuItem Header="贴到桌面（置顶贴图）" Click="PinImageMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="文本工具（复制转换结果）"
                                          IsEnabled="{Binding IsSelectedText}">
                                    <MenuItem Header="转大写" Click="TransformUpperMenuItem_Click" />
                                    <MenuItem Header="转小写" Click="TransformLowerMenuItem_Click" />
                                    <MenuItem Header="去多余空白/空行" Click="TransformTrimMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="JSON 格式化" Click="TransformJsonMenuItem_Click" />
                                    <MenuItem Header="JSON 压缩" Click="TransformJsonMinifyMenuItem_Click" />
                                    <MenuItem Header="URL 解码" Click="TransformUrlDecodeMenuItem_Click" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="撤销删除" Click="UndoDeleteMenuItem_Click" InputGestureText="Ctrl+Z" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemCard"
                                        Style="{StaticResource ModernRowCardStyle}"
                                        MinHeight="56"
                                        Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="TypeAccentBar"
                                                Style="{StaticResource TypeAccentBarStyle}"
                                                ToolTip="左侧色条：蓝=文本 紫=图片 橙=置顶 绿=本会话已从历史复制" />
                                        <Border Grid.Column="1"
                                                Width="26"
                                                Height="26"
                                                CornerRadius="8"
                                                Background="{DynamicResource FillBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource ShortcutNumberConverter}}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource ThumbnailFrameStyle}">
                                                <Grid>
                                                    <TextBlock Text="图片缩略图"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding ThumbnailContent, IsAsync=True, Converter={StaticResource ImageBase64ToSourceConverter}, ConverterParameter=72}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="LowQuality" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="PreviewTextBlock"
                                                           Text="{Binding PreviewText}"
                                                           Style="{StaticResource TextPreviewStyle}" />
                                                <TextBlock x:Name="ImageItemPreviewTextBlock"
                                                           Text="图片记录 · 双击复制并关闭，可放回系统剪贴板"
                                                           Style="{StaticResource ImageHintStyle}" />
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,4,0,0">
                                                    <TextBlock x:Name="SourceProcessBlock"
                                                               Text="{Binding SourceProcess}"
                                                               Style="{StaticResource ModernMutedStyle}"
                                                               FontSize="12" />
                                                    <TextBlock x:Name="DotBlock"
                                                               Text="  ·  "
                                                               Style="{StaticResource ModernMutedStyle}"
                                                               FontSize="12" />
                                                    <TextBlock x:Name="CreatedAtBlock"
                                                               Text="{Binding CreatedAt, Converter={StaticResource RelativeTimeConverter}}"
                                                               Style="{StaticResource ModernCaptionStyle}" />
                                                    <Border Style="{StaticResource BadgePinnedStyle}" Margin="8,0,4,0">
                                                        <TextBlock Text="固定" Style="{StaticResource ModernBadgeTextStyle}"
                                                                   Foreground="{DynamicResource WarningBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeSensitiveStyle}" Margin="0,0,4,0">
                                                        <TextBlock Text="敏感" Style="{StaticResource ModernBadgeTextStyle}"
                                                                   Foreground="{DynamicResource DangerBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeFavoriteStyle}" Margin="0,0,4,0">
                                                        <TextBlock Text="片段" Style="{StaticResource ModernBadgeTextStyle}"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeLinkStyle}" Margin="0,0,4,0">
                                                        <TextBlock Text="链接" Style="{StaticResource ModernBadgeTextStyle}"
                                                                   Foreground="#0D9488" />
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeSessionCopiedStyle}" Margin="0,0,4,0">
                                                        <TextBlock Text="已复制" Style="{StaticResource ModernBadgeTextStyle}"
                                                                   Foreground="{DynamicResource SuccessBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Button x:Name="RowMoreButton"
                                                Grid.Column="3"
                                                Style="{StaticResource ModernMoreButtonStyle}"
                                                FontFamily="Segoe MDL2 Assets"
                                                Content="&#xE712;"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Margin="6,0,0,0"
                                                Visibility="Collapsed"
                                                Click="RowMoreButton_Click" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                        <Setter TargetName="RowMoreButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter TargetName="RowMoreButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Empty state -->
                <Border Panel.ZIndex="5"
                        Style="{StaticResource EmptyStatePanelStyle}"
                        Margin="12"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52"
                                Height="52"
                                CornerRadius="26"
                                Background="{DynamicResource FillBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14">
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   Style="{StaticResource ModernSectionHeaderStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyStateHint}"
                                   Style="{StaticResource ModernMutedStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,14"
                                   TextAlignment="Center" />
                        <TextBlock Text="Ctrl + ` 随时打开"
                                   Style="{StaticResource ModernCaptionStyle}"
                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.ColumnSpan="2"
                        Panel.ZIndex="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,16,0,0"
                        Padding="14,8"
                        CornerRadius="14"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="正在加载剪贴板历史…"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="4"
                        Margin="0,4,0,0">
                <DockPanel LastChildFill="False" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SummaryText}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="UndoDeleteButton"
                            DockPanel.Dock="Right"
                            Content="撤销删除"
                            Style="{StaticResource ModernLinkButtonStyle}"
                            Margin="12,0,0,0"
                            Click="UndoDeleteMenuItem_Click"
                            Visibility="{Binding CanUndoDelete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </DockPanel>
                <TextBlock Text="{Binding ShortcutHintText}"
                           Style="{StaticResource ModernMutedStyle}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
                <Border Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="1"
                        CornerRadius="999"
                        Padding="12,4"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{Binding HasPasteQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PasteQueueText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="清空队列"
                                Width="64"
                                Height="22"
                                MinWidth="0"
                                Padding="0"
                                FontSize="11"
                                Margin="10,0,0,0"
                                Click="ClearPasteQueueButton_Click" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource SuccessBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- 快捷键速查浮层 -->
            <Border Grid.RowSpan="5"
                    MouseLeftButtonDown="ShortcutHelpBackdrop_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ModernModalScrimStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsShortcutHelpVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Width="360"
                        MaxHeight="520"
                        Margin="24"
                        Style="{StaticResource ModernModalCardStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="ShortcutHelpCard_MouseLeftButtonDown">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right"
                                    Content="关闭"
                                    Width="56"
                                    Height="28"
                                    MinWidth="0"
                                    FontSize="12"
                                    Click="ShortcutHelpButton_Click" />
                            <TextBlock Text="剪贴板快捷键"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ShortcutHelpText}"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       FontSize="13"
                                       LineHeight="22"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- 编辑记录浮层 -->
            <Border Grid.RowSpan="5">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ModernModalScrimStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsItemEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Width="480"
                        Margin="24"
                        Style="{StaticResource ModernModalCardStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="编辑剪贴板记录"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="保存后直接覆盖这条历史（不新建记录）。"
                                   Style="{StaticResource ModernMutedStyle}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,10" />
                        <TextBox x:Name="ItemEditorTextBox"
                                 MinHeight="140"
                                 MaxHeight="280"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="10,8"
                                 FontSize="14"
                                 Text="{Binding EditingItemText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,14,0,0">
                            <Button Content="取消"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="80"
                                    Margin="0,0,10,0"
                                    Click="ItemEditorCancelButton_Click" />
                            <Button Content="保存修改"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="100"
                                    Click="ItemEditorSaveButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- 二维码浮层 -->
            <Border Grid.RowSpan="5">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ModernModalScrimStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQrOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Width="340"
                        Margin="24"
                        Style="{StaticResource ModernModalCardStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="手机扫码带走"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="二维码在本机生成，内容不上传。"
                                   Style="{StaticResource ModernMutedStyle}"
                                   FontSize="12"
                                   Margin="0,6,0,12" />
                        <Border Background="#FFFFFF"
                                CornerRadius="12"
                                Padding="12"
                                HorizontalAlignment="Center">
                            <Image Source="{Binding QrImageSource}"
                                   Width="220"
                                   Height="220"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <Button Content="关闭"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="80"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0"
                                Click="QrCloseButton_Click" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- 新建片段浮层 -->
            <Border Grid.RowSpan="5">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ModernModalScrimStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSnippetEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Width="440"
                        Margin="24"
                        Style="{StaticResource ModernModalCardStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="新建常用片段"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="保存后出现在「片段」筛选里；粘贴时 {date} {time} {datetime} {weekday} 会替换成当下时间。"
                                   Style="{StaticResource ModernMutedStyle}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,10" />
                        <TextBox x:Name="SnippetTextBox"
                                 MinHeight="96"
                                 MaxHeight="200"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="10,8"
                                 FontSize="14"
                                 Text="{Binding NewSnippetText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,14,0,0">
                            <Button Content="取消"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="80"
                                    Margin="0,0,10,0"
                                    Click="SnippetCancelButton_Click" />
                            <Button Content="保存片段"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="100"
                                    Click="SnippetSaveButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>