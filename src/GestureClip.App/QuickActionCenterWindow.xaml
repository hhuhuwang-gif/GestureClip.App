<Window x:Class="GestureClip.App.QuickActionCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷动作"
        Width="720" Height="650" MinWidth="640" MinHeight="550"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">
    <Window.Resources>
        <RadialGradientBrush x:Key="CommandAmbient" Center="0.86,0.06" GradientOrigin="0.86,0.06"
                             RadiusX="0.76" RadiusY="1.15">
            <GradientStop Color="#283B82F6" Offset="0" />
            <GradientStop Color="#102DD4BF" Offset="0.48" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </RadialGradientBrush>
        <Style x:Key="CommandPanelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource BrushGlassStrong}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushGlassRim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CommandTagStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="{DynamicResource BrushPrimarySoft}" />
            <Setter Property="BorderBrush" Value="#303B82F6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="CommandFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource BrushPrimaryBright}"
                                BorderThickness="2" CornerRadius="10" Margin="-2">
                            <AdornedElementPlaceholder />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" CornerRadius="24"
            Background="{DynamicResource BrushOverlayPanel}"
            BorderBrush="{DynamicResource BrushGlassRim}"
            BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#17344F" BlurRadius="36" ShadowDepth="8" Opacity="0.22" Direction="270" />
        </Border.Effect>
        <Grid>
            <Border Background="{StaticResource CommandAmbient}" IsHitTestVisible="False" />
            <Grid Margin="24,22,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="GESTURECLIP / 本地动作" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushPrimaryBright}" />
                        <TextBlock Text="快捷动作" Margin="0,4,0,0"
                                   FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                                   FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="{Binding InputHint}" Margin="0,5,20,0" MaxWidth="500"
                                   FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource CommandTagStyle}"
                            VerticalAlignment="Top" Margin="12,2,0,0">
                        <TextBlock Text="{Binding OpenQuickActionHotkeyHint, FallbackValue=Ctrl + Shift + Q}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushPrimaryBright}" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Margin="0,18,0,16" Height="48" CornerRadius="14"
                        Background="{DynamicResource BrushGlassStrong}" BorderBrush="{DynamicResource BrushGlassRim}" BorderThickness="1">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="刷新"
                                Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="62"
                                FocusVisualStyle="{StaticResource CommandFocusVisual}"
                                Margin="6,8,8,8" ToolTip="重新读取剪贴板（F5）"
                                AutomationProperties.Name="重新读取剪贴板"
                                Command="{Binding RefreshInputCommand}" />
                        <TextBlock Text="⌕" Margin="15,0,4,1" FontSize="23"
                                   Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" FontSize="15" BorderThickness="0"
                                 Background="Transparent" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,0" Tag="搜索动作、分类或用途…"
                                 AutomationProperties.Name="搜索快捷动作" />
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="258" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CommandPanelStyle}" Padding="8,12,8,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="8,0,8,10">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding FilteredActions.Count, StringFormat={}{0} 项}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                           Foreground="{DynamicResource BrushTextMuted}" />
                                <TextBlock Text="动作库" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="ActionList" ItemsSource="{Binding FilteredActions}"
                                         FocusVisualStyle="{StaticResource CommandFocusVisual}"
                                         SelectedItem="{Binding SelectedAction}"
                                         ItemContainerStyle="{StaticResource GlassListBoxItemStyle}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="本地动作列表"
                                         MouseDoubleClick="ActionList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource CommandTagStyle}">
                                                        <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushPrimaryBright}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}" Margin="0,0,8,0"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextPrimary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" Margin="0,4,0,0"
                                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFilteredActions}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="没有匹配动作" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="换个关键词，或按 Esc 清空后重新打开" Margin="0,5,0,0"
                                               FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CommandPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource CommandTagStyle}">
                                    <TextBlock Text="本机处理" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushPrimaryBright}" />
                                </Border>
                                <TextBlock Text="{Binding SelectedAction.DisplayName, FallbackValue=选择一个动作}"
                                           FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding SelectedDescription}" Margin="0,7,0,14"
                                       FontSize="12" LineHeight="19" Foreground="{DynamicResource BrushTextSecondary}"
                                       TextWrapping="Wrap" />
                            <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource BrushFillTertiary}"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                <Grid>
                                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12.5"
                                             Background="Transparent" BorderThickness="0" Padding="14"
                                             VerticalContentAlignment="Top"
                                             AutomationProperties.Name="处理结果预览" />
                                    <TextBlock Text="选择动作后按 Shift + Enter 预览结果" Margin="14"
                                               FontSize="12" Foreground="{DynamicResource BrushTextMuted}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Background="{DynamicResource BrushGlassStrong}"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ProgressBar Width="150" Height="3" IsIndeterminate="True" />
                                            <TextBlock Text="正在本机处理" Margin="0,10,0,0" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="预览" Style="{StaticResource SecondaryButtonStyle}"
                                        FocusVisualStyle="{StaticResource CommandFocusVisual}"
                                        Margin="0,0,8,0" Command="{Binding PreviewSelectedCommand}"
                                        ToolTip="Shift + Enter" AutomationProperties.Name="预览处理结果" />
                                <Button Grid.Column="1" Content="复制结果"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                        FocusVisualStyle="{StaticResource CommandFocusVisual}"
                                        Command="{Binding RunSelectedCommand}" ToolTip="Enter"
                                        AutomationProperties.Name="处理并复制结果" />
                                <Button Grid.Column="2" Content="处理并粘贴"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        FocusVisualStyle="{StaticResource CommandFocusVisual}"
                                        Command="{Binding RunAndPasteCommand}" ToolTip="Ctrl + Enter"
                                        AutomationProperties.Name="处理并粘贴到目标应用" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="2,14,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                               Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="↑↓ 选择 · Enter 复制 · Shift+Enter 预览 · Ctrl+Enter 粘贴"
                               Margin="18,0,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                               Foreground="{DynamicResource BrushTextMuted}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
