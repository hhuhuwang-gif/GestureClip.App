<Window x:Class="GestureClip.App.WorkBearWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工位小熊挂件"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI, Segoe UI Emoji"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseDoubleClick="Window_MouseDoubleClick"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="打开工位小熊 Hub" Click="OpenHubMenuItem_Click" />
            <Separator />
            <MenuItem Header="选择桌宠图片…（GIF 会动）" Click="ChoosePetMenuItem_Click" />
            <MenuItem Header="移除桌宠图片" Click="RemovePetMenuItem_Click" />
            <Separator />
            <MenuItem Header="关闭挂件" Click="CloseWidgetMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>
    <Border CornerRadius="999"
            Padding="14,8"
            Background="{DynamicResource BrushGlassCard}"
            BorderBrush="{DynamicResource BrushGlassRim}"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            ToolTip="拖动移动 · 双击打开 Hub · 右键换桌宠 / 关闭">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Opacity="0.18" Direction="270" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="PetImage"
                   Width="30"
                   Height="30"
                   Margin="0,0,9,0"
                   Visibility="Collapsed"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   VerticalAlignment="Center" />
            <TextBlock x:Name="PetEmoji"
                       Text="🐻"
                       FontSize="17"
                       Margin="0,0,9,0"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="EarnedText"
                       Text="¥0.00"
                       FontSize="13.5"
                       FontWeight="Bold"
                       Foreground="{DynamicResource BrushPrimaryBright}"
                       VerticalAlignment="Center" />
            <TextBlock Text="  ·  "
                       FontSize="12"
                       Foreground="{DynamicResource BrushTextMuted}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CountdownText"
                       Text="--:--:--"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
